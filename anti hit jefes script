local function serverHop()
    if hopping then return end
    hopping = true
    hopBtn.Text = "🔎 Buscando servidor..."

    local ok, result = pcall(function()
        return game:HttpGet(
            "https://games.roblox.com/v1/games/" .. placeId ..
            "/servers/Public?sortOrder=Asc&limit=" .. MAX_SERVERS
        )
    end)

    if not ok or not result then
        hopBtn.Text = "❌ Error al buscar"
        task.wait(1.5)
        hopBtn.Text = "🚀 SERVER HOP"
        hopping = false
        return
    end

    local decoded, data = pcall(function()
        return httpService:JSONDecode(result)
    end)

    if not decoded or type(data) ~= "table" or type(data.data) ~= "table" then
        hopBtn.Text = "❌ Respuesta inválida"
        task.wait(1.5)
        hopBtn.Text = "🚀 SERVER HOP"
        hopping = false
        return
    end

    local servers = {}
    for _, server in ipairs(data.data) do
        if server.id and server.id ~= game.JobId
            and type(server.playing) == "number"
            and type(server.maxPlayers) == "number"
            and server.playing < server.maxPlayers then
            table.insert(servers, server)
        end
    end

    if #servers == 0 then
        hopBtn.Text = "⚠️ No hay servidores"
        task.wait(1.5)
        hopBtn.Text = "🚀 SERVER HOP"
        hopping = false
        return
    end

    table.sort(servers, function(a, b)
        return (a.playing / a.maxPlayers) < (b.playing / b.maxPlayers)
    end)

    local pool = math.min(10, #servers)
    local chosen = servers[math.random(1, pool)]

    hopBtn.Text = "🚀 Entrando (" .. chosen.playing .. "/" .. chosen.maxPlayers .. ")..."

    task.wait(0.4)

    pcall(function()
        teleportService:TeleportToPlaceInstance(placeId, chosen.id, localPlayer)
    end)

    hopping = false
end

